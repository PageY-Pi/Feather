/target
# The vendored egui-winit patch is built in place, so it grows its own target/.
/vendor/*/target/
Cargo.lock.bak
*.redb
*.redb.tmp
.feather/
.pi-subagents/
.pi/

# Build/release artifacts and generated caches
/dist/
__pycache__/
*.py[cod]

# Local runtime locks, previews, and test-created homes
**/config.lock
**/auth.lock
/crates/feather-gui/fixture/

# Credentials and machine-local overrides
.env
.env.*
!.env.example
*.pem
*.key
